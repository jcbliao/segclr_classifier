gnn/code_pdf/

# model checkpoints -- large, regeneratable; keep the JSON metrics/READMEs
**/results/**/*.pt
**/checkpoint_*.pt

# notebook input aggregates -- rebuilt by scripts/sbatch/rebuild_path_analysis.sh
analysis/embedding_paths_summary.npz

# per-window prediction/geometry caches -- ~90MB per run, rebuilt by
# scripts/sbatch/build_feature_prediction_cache.sh. The .summary.json beside
# each one is what the notebook actually reads, and is small enough to keep,
# mirroring results/ keeping metrics but not checkpoints.
analysis/feature_prediction_cache/*.npz

